{
  "version": "0.3.0",
  "configurations": [
    {
      "name": "Launch XiaoZhi Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/src",
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "1",
        "CC": "gcc",
        "CXX": "g++",
        "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug XiaoZhi Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "1",
        "CC": "gcc",
        "CXX": "g++",
        "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}",
        "GIN_MODE": "debug"
      },
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "showLog": true,
      "dlvFlags": ["--check-go-version=false"],
      "trace": "verbose"
    },
    {
      "name": "Debug Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "1",
        "CC": "gcc",
        "CXX": "g++",
        "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}"
      },
      "console": "integratedTerminal",
      "args": ["-test.v"]
    },
    {
      "name": "Attach to Process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickGoProcess}",
      "env": {
        "CGO_ENABLED": "1"
      }
    }
  ]
}
